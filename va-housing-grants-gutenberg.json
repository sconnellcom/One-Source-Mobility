              "blockName": "core/group",
              "attrs": {
                "className": "grant-card"
              },
              "innerBlocks": [
                {
                  "blockName": "core/heading",
                  "attrs": {
                    "level": 3,
                    "content": "SAH Grant"
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "<strong>Up to $121,812 (FY2026 est.)</strong> for severe disabilities (e.g., loss of limbs, blindness). Funds new builds, major adaptations, or mortgage reductions."
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "Specially Adapted Housing Grant for veterans with qualifying severe service-connected disabilities."
                  }
                }
              ]
            },
            {
              "blockName": "core/group",
              "attrs": {
                "className": "grant-card"
              },
              "innerBlocks": [
                {
                  "blockName": "core/heading",
                  "attrs": {
                    "level": 3,
                    "content": "SHA Grant"
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "<strong>Up to $24,565 (FY2026 est.)</strong> for mobility disabilities. Covers adaptations to existing homes, including roll-in showers and widened doorways."
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "Special Housing Adaptation Grant for veterans with service-connected disabilities affecting mobility."
                  }
                }
              ]
            }
          ]
