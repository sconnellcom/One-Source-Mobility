                {
                  "blockName": "core/heading",
                  "attrs": {
                    "level": 3,
                    "content": "HISA Grant"
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "<strong>Up to $6,800 lifetime</strong> (service-connected) or $2,000 for others. Covers medically justified modifications like grab bars, widened doors, and ramps."
                  }
                },
                {
                  "blockName": "core/paragraph",
                  "attrs": {
                    "content": "Home Improvements and Structural Alterations Grant for service-connected disabilities or 50%+ rating."
                  }
                }
              ]
            },
