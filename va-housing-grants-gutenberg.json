        {
          "blockName": "core/html",
          "attrs": {
            "content": "<table style=\"width: 100%; border-collapse: collapse; background-color: white; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); border-radius: 8px; overflow: hidden;\"><thead><tr style=\"background-color: #0066cc; color: white;\"><th style=\"padding: 1rem; text-align: left; font-weight: 600;\">Step</th><th style=\"padding: 1rem; text-align: left; font-weight: 600;\">Key Actions</th><th style=\"padding: 1rem; text-align: left; font-weight: 600;\">Pro Tip</th></tr></thead><tbody><tr style=\"border-bottom: 1px solid #dee2e6;\"><td style=\"padding: 1rem; vertical-align: top;\"><strong>1. Verify Credentials</strong></td><td style=\"padding: 1rem; vertical-align: top;\">Licensed, insured, VA-savvy (CAPS/ATP); check references/reviews.</td><td style=\"padding: 1rem; vertical-align: top;\">Ask for veteran project portfolios.</td></tr><tr style=\"border-bottom: 1px solid #dee2e6; background-color: #f8f9fa;\"><td style=\"padding: 1rem; vertical-align: top;\"><strong>2. Get Multiple Bids</strong></td><td style=\"padding: 1rem; vertical-align: top;\">3+ itemized estimates matching grant scopes.</td><td style=\"padding: 1rem; vertical-align: top;\">Ensure ADA/VA compliance.</td></tr><tr style=\"border-bottom: 1px solid #dee2e6;\"><td style=\"padding: 1rem; vertical-align: top;\"><strong>3. Assess Expertise</strong></td><td style=\"padding: 1rem; vertical-align: top;\">Accessibility focus (not general remodels); OT collaboration.</td><td style=\"padding: 1rem; vertical-align: top;\">Confirm ramp/lift training.</td></tr><tr style=\"background-color: #f8f9fa;\"><td style=\"padding: 1rem; vertical-align: top;\"><strong>4. Review Process</strong></td><td style=\"padding: 1rem; vertical-align: top;\">Clear timelines, grant paperwork help.</td><td style=\"padding: 1rem; vertical-align: top;\">Lifetime warranties on installs.</td></tr></tbody></table>"
