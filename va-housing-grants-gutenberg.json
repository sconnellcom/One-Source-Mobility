        {
          "blockName": "core/html",
          "attrs": {
            "content": "<form class=\"contact-form\" id=\"contact-form\" action=\"#\" method=\"post\"><div class=\"form-row\"><div class=\"form-group\"><label for=\"name\">Name *</label><input type=\"text\" id=\"name\" name=\"name\" required></div><div class=\"form-group\"><label for=\"phone\">Phone *</label><input type=\"tel\" id=\"phone\" name=\"phone\" required></div></div><div class=\"form-row\"><div class=\"form-group\"><label for=\"email\">Email *</label><input type=\"email\" id=\"email\" name=\"email\" required></div><div class=\"form-group\"><label for=\"service-branch\">Branch of Service</label><select id=\"service-branch\" name=\"service-branch\"><option value=\"\">Select branch</option><option value=\"army\">Army</option><option value=\"navy\">Navy</option><option value=\"air-force\">Air Force</option><option value=\"marines\">Marines</option><option value=\"coast-guard\">Coast Guard</option><option value=\"space-force\">Space Force</option></select></div></div><div class=\"form-group\"><label for=\"address\">Home Address *</label><input type=\"text\" id=\"address\" name=\"address\" required></div><div class=\"form-group\"><label for=\"grant-type\">Which Grant Are You Interested In? *</label><select id=\"grant-type\" name=\"grant-type\" required><option value=\"\">Select a grant type</option><option value=\"hisa\">HISA (Home Improvements and Structural Alterations)</option><option value=\"sah\">SAH (Specially Adapted Housing)</option><option value=\"sha\">SHA (Special Housing Adaptation)</option><option value=\"tra\">TRA (Temporary Residence Adaptation)</option><option value=\"not-sure\">Not Sure / Need Guidance</option></select></div><div class=\"form-group\"><label for=\"modifications\">What Modifications Are You Considering?</label><textarea id=\"modifications\" name=\"modifications\" rows=\"4\" placeholder=\"e.g., wheelchair ramp, bathroom remodel, ceiling lift, widened doorways...\"></textarea></div><button type=\"submit\" class=\"btn btn-primary btn